# Database
AIP_DB_PATH=data/pipeline.db
AIP_DB_URL=sqlite:///data/pipeline.db

# Keepa API (Amazon data)
KEEPA_API_KEY=your-keepa-key-here

# OpenAI / Vision API
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
AIP_OPENAI_MODEL=gpt-4o

# Directories
AIP_TEMPLATES_DIR=templates
AIP_OUTPUT_DIR=data/output
AIP_IMAGE_OUTPUT_DIR=data/images

# App
AIP_LOG_LEVEL=INFO
AIP_FLASK_PORT=5100
